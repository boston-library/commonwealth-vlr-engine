<%= form_tag item_feedback_path,
             id: 'item_feedback_form',
             class: "modal_form",
             method: :post do %>
  <div class="modal-body">
    <% unless @errors.empty? %>
      <div id="error_explanation" class="alert alert-error">
        <ul class="errors">
          <% @errors.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="form-group row">
      <div class="col-sm-9">
        <%= hidden_field_tag 'ark_id', @document[:id] %>
        <div class="row mb-3">
          <label class="col-md-3 col-form-label text-end"><%= t('blacklight.feedback.form.name') %></label>
          <div class="col-md-8 col-lg-8">
            <%= text_field_tag :name, params[:name], class: 'form-control', required: true %>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-md-3 col-form-label text-end"><%= t('blacklight.feedback.form.email') %></label>
          <div class="col-md-8 col-lg-8">
            <%= email_field_tag :email, params[:email], class: 'form-control', required: true %>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-md-3 col-form-label text-end"><%= t('blacklight.feedback.form.topic.label') %></label>
          <div class="col-md-8 col-lg-8">
            <%= select_tag(:topic,
                           options_for_select(t('blacklight.feedback.item.topic.options').values.map { |v| v[:option] }),
                           id: 'message_type_select',
                           class: 'form-select') %>
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-md-3 col-form-label text-end"><%= t('blacklight.feedback.form.message') %></label>
          <div class="col-md-8 col-lg-8">
            <%= text_area_tag :message, params[:message], size: '24x6', class: 'form-control', required: true %>
          </div>
        </div>
        <div class="row mb-3">
          <div class="offset-md-3 col-md-4">
            <%# `noscript: false` param is required, or captcha submission doesn't work from inside a modal,
                 see https://stackoverflow.com/a/79648299 %>
            <%= recaptcha_tags(id: 'item_feedback_recaptcha', noscript: false) %>
            <%= submit_tag(t('blacklight.feedback.submit'), class: 'btn btn-primary mt-2') %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>