<%# prefer to use Blacklight::System::ModalComponent, or the full layout gets rendered %>
<%= render Blacklight::System::ModalComponent.new do |component| %>
  <% component.with_prefix do
    render partial: 'shared/modal_transition'
  end %>
  <% component.with_title do
    truncate("#{t('blacklight.ocr.search.results.title')}: #{render_title(@document, false)}",
             length: 55, separator: ' ')
  end %>

  <%= render partial: 'search_form_ocr' %>

  <% component.with_footer do %>
    <div id="ocr_pagination" class="bottom">
      <%= render Blacklight::Response::PaginationComponent.new(response: @response)  if params[:ocr_q] %>
    </div>
  <% end %>
<% end %>
