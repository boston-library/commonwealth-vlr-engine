<%# assumes we only have one video for an item %>
<div id="img_show_container">
  <div id="img_show_canvas">
    <%= content_tag(:video,
                    src: filestream_disseminator_url(video_files.first['storage_key_base_ss'], 'video_access_mp4'),
                    class: 'img_show', id: 'video_player',
                    controls: true, poster: thumbnail_url(document),
                    crossorigin: 'anonymous', controlsList: 'nodownload') do %>
      <%= content_tag(:track, nil, src: filestream_disseminator_url(video_files.first['storage_key_base_ss'], 'web_vtt_captions'),
                      default: true, kind: 'captions', srclang: 'en') if has_captions?(video_files.first) %>
    <% end %>
  </div>
</div>
