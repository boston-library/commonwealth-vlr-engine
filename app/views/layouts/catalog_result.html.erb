<%# override:
  - call our own template
  - add opengraph markup
  - disable sidebar rendering %>
<% content_for(:head) do %>
  <%= render CommonwealthVlrEngine::Document::OpengraphComponent.new(document: @document,
                                                                     exemplary_document: @exemplary_document,
                                                                     object_files: @object_files) %>
<% end %>

<% content_for(:content) do %>
  <section class="<%= show_content_classes %>">
    <%= yield %>
  </section>

  <!--
  <section class="<%# show_sidebar_classes %>">
    <%# content_for(:sidebar) %>
  </section>
  -->
<% end %>

<%= render template: "layouts/commonwealth-vlr-engine/base" %>
