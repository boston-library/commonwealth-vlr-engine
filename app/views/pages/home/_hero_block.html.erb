<%# hero image and search box %>
<div id="hero_block" class="row">
  <div class="container-fluid"
       style="background-image:url('<%= iiif_image_url(@banner_image.image_pid,
                                                       { size: @banner_image.size,
                                                         region: @banner_image.region }) if @banner_image %>')">
    <div id="hero_content_wrapper">
      <h1 id="hero_headline"><%= t('blacklight.home.banner.center_text') %></h1>
      <div id="hero_search_wrapper">
        <%= render CommonwealthVlrEngine::SimpleSearchBarComponent.new(
          url: search_action_url(controller: 'catalog'),
          advanced_search_url: search_action_url(controller: 'catalog', action: 'advanced_search'),
          classes: %w[simple-search-query-form hero-search-query-form],
          params: search_state.params_for_search.except(:qt),
          autocomplete_path: suggest_index_catalog_path) %>
      </div>
    </div>
    <% if @banner_image %>
      <div id="hero_image_attribution">
        <%= I18n.t('blacklight.collections.image_title_prefix') %>
        <%= link_to(@banner_image.title,
                    solr_document_path(@banner_image.object_pid),
                    id: 'hero_image_attribution_link',
                    class: 'banner_image_caption_link') %>
      </div>
    <% end %>
  </div>
</div>
