<div id="banner_image_container">
  <%= banner_image_link %>
  <% if render_image_title? %>
    <div id="banner_image_caption">
      <%= I18n.t('blacklight.collections.image_title_prefix') %>
      <%= link_to(banner_image_title,
                  solr_document_path(@exemplary_document['id']),
                  class: 'banner_image_caption_link') %>
    </div>
  <% end %>
</div>
