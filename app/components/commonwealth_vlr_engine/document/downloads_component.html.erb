<button id="download_links" class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
  <%= icon('fas', 'download', class: 'show-tools-icon') %>
  <span><%= I18n.t('blacklight.downloads.title') %></span>
</button>

<ul class="dropdown-menu">
  <div class="downloads-dropdown-menu-header"><%= I18n.t('blacklight.downloads.dropdown.header') %></div>
  <% download_links.each do |link| %>
    <li class="download_list_item"><%= link %></li>
  <% end %>
</ul>