<div class="featured_items">
  <h4><%= I18n.t("blacklight.#{context}.featured") %></h4>
  <%# below based on blacklight-gallery/app/views/catalog/_document_masonry.html.erb %>
  <div class="documents_featured documents-masonry">
    <%= render Blacklight::Gallery::DocumentComponent.with_collection(featured_documents_presenters) %>
  </div>
  <% if render_view_all_link %>
    <div class="featured_view_all_wrap">
      <%= link_to_all_featured_items(classes: 'btn btn-primary') %>
    </div>
  <% end %>
</div>
